{
  "source": {
    "bart_input_dir": "/path/to/source/bart_inputs",
    "no_wave_kspace": "/path/to/full_no_wave_kspace.npy",
    "sampling_mask": "/path/to/source_sampling_mask.npy",
    "existing_maps": "/path/to/coil_sens",
    "calibration_kspace": "/path/to/kspace_calib",
    "sequence": "/path/to/matching_sequence.seq",
    "twix": "/path/to/matching_twix.dat",
    "synthesis_manifest": "/path/to/source_synthesis_manifest.json",
    "companion_manifests": [],
    "acceleration_ry_rz": [3, 2],
    "subject": "example-retro-low-resolution"
  },
  "output_root": "/path/to/new_dataset_output",
  "pe_matrix_policy": "nearest multiple of 4",
  "cases": [
    {
      "resolution_mm_xyz": [1.5, 1.0, 1.0],
      "acceleration_ry_rz": [3, 2],
      "label": "lower physical-X resolution"
    }
  ],
  "reconstruction": {
    "bart": "bart",
    "regularizer": "llr",
    "lambda": 0.00002,
    "block_size": 8,
    "iterations": 100,
    "tolerance": 0.000001,
    "maximum_eigenvalue": null
  },
  "runtime": {
    "fft_workers": 4,
    "readout_chunk": 8
  }
}
