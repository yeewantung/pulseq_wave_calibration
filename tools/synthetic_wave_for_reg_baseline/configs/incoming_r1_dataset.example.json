{
  "format_version": 1,
  "dataset_id": "incoming-r1-development",
  "subject": "incoming-r1-development",
  "inputs": {
    "twix": "/path/to/meas_incoming_r1.dat",
    "wave_sequence": "/path/to/synthetic_wave_sequence.seq",
    "dicom": {
      "enabled": true,
      "directory": "/path/to/unfiltered_normalized_dicom",
      "required_image_type_tokens": [
        "ND",
        "NORM"
      ],
      "excluded_image_type_tokens": [
        "DIS2D",
        "DIS3D"
      ]
    }
  },
  "outputs": {
    "root": "/path/to/incoming_r1_synthetic_wave",
    "inspection_report": "metadata/dataset_inspection.json",
    "coil_compression_prefix": "calibration/coil_compression",
    "source_reconstruction_prefix": "reconstructions/no_wave/source",
    "wave_synthesis_dir": "synthetic_wave/full_encoding",
    "bart_export_dir": "synthetic_wave/target_sampling",
    "lambda0_reconstruction_dir": "reconstructions/synthetic_wave/lambda0"
  },
  "geometry": {
    "logical_axes": [
      "readout",
      "phase_encode_1",
      "phase_encode_2"
    ],
    "matrix": [
      256,
      256,
      256
    ],
    "fov_mm": [
      256.0,
      256.0,
      256.0
    ]
  },
  "sampling": {
    "source_acceleration_pe1_pe2": [
      1,
      1
    ],
    "synthetic_wave_acceleration_pe1_pe2": [
      3,
      2
    ],
    "synthetic_wave_residue_pe1_pe2": [
      1,
      0
    ],
    "synthetic_wave_mask_kind": "cartesian_with_full_pe1_acs",
    "synthetic_wave_acs_pe1_start": 115,
    "synthetic_wave_acs_pe1_stop_exclusive": 139,
    "readout_oversampling_factor": 2.0,
    "require_complete_source_grid": true
  },
  "reconstruction": {
    "physical_coils": 64,
    "virtual_coils": 12,
    "coil_compression_source": "image",
    "grappa": {
      "kernel": [
        5,
        5,
        5
      ],
      "regularization": 0.01
    },
    "bart": {
      "use_gpu": true,
      "calibration_source": "image",
      "maximum_eigenvalue": null,
      "ecalib_crop": 0.8,
      "ecalib_intensity_correction": false,
      "lambda0_iterations": 300,
      "lambda0_tolerance": 0.001
    }
  },
  "wave_synthesis": {
    "extended_readout_samples": 1024,
    "calibration_ncalib1": 72,
    "calibration_nacs": 32,
    "orientation": "SAG",
    "pe1_phase_sign": -1,
    "pe2_phase_sign": -1,
    "diagnostic_coils": [
      1,
      2,
      3,
      4
    ]
  },
  "evaluation": {
    "ranking_reference": {
      "kind": "grappa",
      "path": "/path/to/no_wave_grappa_reference.nii.gz"
    },
    "dicom_intensity_ranking_enabled": false,
    "brain_mask": {
      "usage": "metrics_only",
      "path": null
    }
  }
}
